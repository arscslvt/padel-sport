{
  "name": "padel-sport",
  "version": "0.1.0",
  "packageManager": "bun@1.3.4",
  "private": true,
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "dev:mobile:clean": "bun run --cwd apps/mobile dev:clean",
    "dev:backend": "bun run --cwd packages/backend dev",
    "build:web": "bun run --cwd apps/web build && sh scripts/stage-standalone.sh web",
    "build:dashboard": "bun run --cwd apps/dashboard build && sh scripts/stage-standalone.sh dashboard",
    "start:web": "HOSTNAME=0.0.0.0 node .deploy/web/apps/web/server.js",
    "start:dashboard": "HOSTNAME=0.0.0.0 node .deploy/dashboard/apps/dashboard/server.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "patchedDependencies": {
    "vaul@1.1.2": "patches/vaul@1.1.2.patch"
  }
}
