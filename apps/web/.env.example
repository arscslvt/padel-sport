# Sanity — CMS degli articoli/eventi (/studio)
# I valori di projectId e dataset vengono scritti da `bunx sanity@latest init --env .env.local`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-10

# Necessario SOLO se il dataset è privato (Sanity → Project → API → Tokens, permesso "Viewer").
# Senza token un dataset privato risponde 200 con risultati vuoti, non un errore.
# Lasciare vuoto se il dataset è pubblico.
SANITY_API_READ_TOKEN=

# Resend — invio delle mail della richiesta giocatori (/api/match-request).
# Il dominio del mittente deve essere verificato su Resend, altrimenti l'invio
# viene rifiutato: la richiesta resta comunque salvata su Convex.
RESEND_API_KEY=
EMAIL_FROM="Padel Sport Melilli <noreply@asdpadelsport.com>"
MATCH_REQUEST_INBOX=support@asdpadelsport.com

# Convex — necessaria anche lato server per registrare le richieste.
NEXT_PUBLIC_CONVEX_URL=

# Casella che riceve le richieste dal modulo di supporto (/api/support-request).
SUPPORT_REQUEST_INBOX=support@asdpadelsport.com

# Segreto con cui Convex chiama /api/bookings/cancelled per avvisare della
# disdetta. Lo stesso valore va impostato sul deployment Convex, insieme a
# SITE_URL: senza, la prenotazione si annulla comunque ma nessuno viene
# avvisato. Genera con: openssl rand -base64 32
BOOKING_WEBHOOK_SECRET=

# Casella che riceve le prenotazioni dei campi fatte dal sito (/api/bookings/confirm):
# è la copia per la segreteria, con telefono, squadra e note alla struttura.
BOOKING_INBOX=support@asdpadelsport.com

# Casella che riceve le iscrizioni agli eventi (/api/events/rsvp), cioè il
# blocco «Modulo di iscrizione» inserito dallo Studio nel corpo di un evento.
EVENT_RSVP_INBOX=support@asdpadelsport.com

# ntfy — URL completo del topic su cui arriva la push di ogni richiesta dai
# moduli, come sveglia se la mail tarda. Senza, le richieste si salvano e le
# mail partono lo stesso: resta solo un avviso nei log.
NTFY_TOPIC_URL=https://ntfy.sh/il-tuo-topic

# Amplitude — chiave di ingestione del progetto (pubblica per definizione: finisce
# nel bundle). Va impostata anche in produzione: essendo inlinata al build, se
# manca l'SDK resta spento e in console compare l'avviso lanciato dall'init.
NEXT_PUBLIC_AMPLITUDE_API_KEY=03d875159997a2116076fc33cd42df1e
